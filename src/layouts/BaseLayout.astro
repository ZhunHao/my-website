---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollToTop from "../components/ScrollToTop";
import { getImage } from "astro:assets";
import { Font } from "astro:assets";
import "../styles/global.css";
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_AUTHOR,
  CDN_FAVICON_URL,
  CDN_COVER_IMAGE_URL,
  SOCIAL_LINKS,
} from "../consts";
// Canonical/OG URLs must use the production origin (Astro.site), not
// Astro.request.url — at build time the request URL is the local dev
// server (e.g. http://localhost:4321), which would leak into canonicals
// and OG tags in the static output.
const siteOrigin = Astro.site
  ? Astro.site.origin
  : new URL(Astro.request.url).origin;
const baseUrl = siteOrigin;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const metaImage = await getImage({
  src: CDN_COVER_IMAGE_URL,
  alt: `Cover image for ${SITE_TITLE} website`,
  height: 720,
  width: 1280,
  decoding: "async",
  format: "webp",
  loading: "lazy",
});

const favicon_webp = await getImage({
  src: CDN_FAVICON_URL,
  alt: `${SITE_TITLE} favicon`,
  height: 400,
  width: 400,
  decoding: "async",
  loading: "lazy",
  format: "png",
});

export interface Props {
  image?: string;
  description?: string;
  author?: string;
  pubDate?: string;
  updatedDate?: string;
  title?: string;
  site_name?: string;
  alt?: string;
  is404Page?: boolean;
  hideHeaderFooter?: boolean;
  noindex?: boolean;
  tags?: string[];
}

const {
  image,
  description,
  author,
  pubDate,
  updatedDate,
  title,
  site_name,
  alt,
  is404Page = false,
  hideHeaderFooter = false,
  noindex = false,
  tags,
} = Astro.props;

// Compute the resolved page title used in <title> and OG tags. Pages
// other than the homepage get suffixed with the site title for context
// in browser tabs and search results — but only when the combined
// length stays within Google's ~65-char SERP truncation budget. Long
// post titles keep their full meaning instead.
const TITLE_SUFFIX_BUDGET = 65;
function withBrandSuffix(t: string): string {
  if (t === SITE_TITLE) return t;
  const suffixed = `${t} | ${SITE_TITLE}`;
  return suffixed.length <= TITLE_SUFFIX_BUDGET ? suffixed : t;
}
const resolvedTitle = title ? withBrandSuffix(title) : SITE_TITLE;
const resolvedDescription = description || SITE_DESCRIPTION;
const resolvedImage = image || `${baseUrl}${metaImage?.src}`;
const resolvedAlt = alt || `Cover image for ${SITE_TITLE} website`;

// Schema.org structured data
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE_AUTHOR,
  url: baseUrl,
  image: `${baseUrl}${favicon_webp.src}`,
  sameAs: Object.values(SOCIAL_LINKS),
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site_name || SITE_TITLE,
  url: baseUrl,
  description: description || SITE_DESCRIPTION,
  potentialAction: {
    "@type": "SearchAction",
    target: `${baseUrl}/search?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};

// Build breadcrumb from URL path segments
const pathSegments = Astro.url.pathname.split("/").filter((s) => s.length > 0);
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Home", item: baseUrl },
  ...pathSegments.map((segment, i) => ({
    "@type": "ListItem",
    position: i + 2,
    name:
      i === pathSegments.length - 1 && title
        ? title
        : segment.replace(/[-_]/g, " "),
    item: `${baseUrl}/${pathSegments.slice(0, i + 1).join("/")}`,
  })),
];
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
};

// Format dates for structured data
const formattedPubDate = pubDate ? new Date(pubDate).toISOString() : null;
const formattedUpdatedDate = updatedDate
  ? new Date(updatedDate).toISOString()
  : null;

// Article schema for blog post pages — emitted only when pubDate is
// set, which signals the page represents a published article. Improves
// rich-result eligibility (date, author, image, publisher).
const articleSchema = pubDate
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title || SITE_TITLE,
      description: resolvedDescription,
      image: resolvedImage,
      url: canonicalUrl,
      datePublished: formattedPubDate,
      ...(formattedUpdatedDate
        ? { dateModified: formattedUpdatedDate }
        : { dateModified: formattedPubDate }),
      author: {
        "@type": "Person",
        name: author || SITE_AUTHOR,
        url: baseUrl,
      },
      publisher: {
        "@type": "Person",
        name: SITE_AUTHOR,
        url: baseUrl,
      },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalUrl,
      },
      ...(tags && tags.length > 0 ? { keywords: tags.join(", ") } : {}),
    }
  : null;

// RSS feeds advertised in <head> so feed readers can auto-discover. The
// path matches the per-collection rss.xml.ts routes already defined.
const rssFeeds: { title: string; href: string }[] = [
  { title: "vignettes", href: "/vignettes/rss.xml" },
  { title: "the_atelier", href: "/the_atelier/rss.xml" },
  { title: "astrophotography", href: "/astrophotography/rss.xml" },
  { title: "travel_photos", href: "/travel_photos/rss.xml" },
];
---

<html class="bg-[rgb(244,242,238)] dark:bg-[rgb(34,33,37)]" lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Primary: SVG, adapts to prefers-color-scheme -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- PNG fallbacks for browsers without SVG favicon support -->
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48-light.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32-light.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16-light.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16-dark.png" media="(prefers-color-scheme: dark)" />
    <!-- iOS home screen — single file, no theme awareness -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f2ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#222125" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Per-collection RSS feeds for reader auto-discovery -->
    {
      rssFeeds.map((feed) => (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={`${SITE_TITLE} — ${feed.title}`}
          href={feed.href}
        />
      ))
    }

    <!-- Fonts -->
    <Font cssVariable="--font-inconsolata" preload />
    <Font cssVariable="--font-overpass-mono" preload />

    <!-- Basic SEO -->
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="author" content={author || SITE_AUTHOR} />
    {tags && tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}

    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content={pubDate ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:site_name" content={site_name || SITE_TITLE} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:alt" content={resolvedAlt} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:image:alt" content={resolvedAlt} />

    <!-- Article-specific metadata (only for pages with pubDate) -->
    {
      pubDate && (
        <>
          <meta property="article:published_time" content={formattedPubDate} />
          <meta property="article:author" content={author || SITE_AUTHOR} />
        </>
      )
    }
    {
      updatedDate && (
        <meta property="article:modified_time" content={formattedUpdatedDate} />
      )
    }
    {
      pubDate &&
        tags &&
        tags.map((tag) => <meta property="article:tag" content={tag} />)
    }

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    {
      articleSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(articleSchema)}
        />
      )
    }

    <ClientRouter />
  </head>
  <body
    class="flex flex-col flex-wrap justify-between md:pt-8 md:pr-16 md:pb-8 md:pl-16 p-8 max-w-full min-h-screen overflow-x-hidden dark:bg-[rgb(34,33,37)] dark:text-[rgb(245,245,245)]"
  >
    {!hideHeaderFooter && <Header is404Page={is404Page} />}
    <!-- min-w-0: override flexbox min-width:auto default so <main> can
         shrink below its content's intrinsic width (e.g. NextPost's 704 px
         card row). Without this, wide children propagate up and push the
         page beyond the viewport on mobile. -->
    <main class="min-w-0 max-w-full">
      <slot />
    </main>
    <ScrollToTop client:idle />
    {!hideHeaderFooter && <Footer />}
  </body>
</html>
<style is:global>
  .astro-code,
  .astro-code span {
    background-color: var(--shiki-light-bg) !important;
    color: var(--shiki-light) !important;
    font-style: var(--shiki-light-font-style) !important;
    font-weight: var(--shiki-light-font-weight) !important;
    text-decoration: var(--shiki-light-text-decoration) !important;
  }
  .dark .astro-code,
  .dark .astro-code span {
    background-color: var(--shiki-dark-bg) !important;
    color: var(--shiki-dark) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }
</style>
