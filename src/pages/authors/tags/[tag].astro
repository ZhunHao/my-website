---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogPost from "../../../components/BlogPost.astro";
import { sortByDate } from "../../../components/sortByDate";
import { buildTagPaths } from "../../../scripts/collections";
import { COLLECTION_META } from "../../../consts";

export async function getStaticPaths() {
  const entries = await getCollection("authors");
  return buildTagPaths(entries, "authors");
}

const { tag } = Astro.params;
const { posts, collectionSlug } = Astro.props;
const collectionTitle =
  COLLECTION_META[collectionSlug]?.title ?? collectionSlug;
const description = `${posts.length} ${collectionTitle.toLowerCase()} ${posts.length === 1 ? "entry" : "entries"} tagged "${tag}".`;
---

<BaseLayout
  title={`${tag} — ${collectionTitle}`}
  description={description}
  tags={[tag!]}
  is404Page={false}
>
  {
    posts
      .sort(sortByDate)
      .map((post) => (
        <BlogPost
          url={`/${collectionSlug}/${post.id}/`}
          image={post.data?.image?.src || ""}
          alt={post.data?.image?.alt || ""}
          title={post.data?.title || ""}
          description={post.data?.description || ""}
          pubDate={post.data?.pubDate || ""}
          positionx={post.data?.image?.positionx || ""}
          positiony={post.data?.image?.positiony || ""}
        />
      ))
  }
</BaseLayout>
