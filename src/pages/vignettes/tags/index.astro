---
import TagLayout from "../../../layouts/TagLayout.astro";
import { COLLECTION_META } from "../../../consts";
const directory = "vignettes";
const pageTitle = `${COLLECTION_META[directory].title} Tag Index`;
const description = `Browse ${COLLECTION_META[directory].title.toLowerCase()} posts by tag.`;
---

<TagLayout directory={directory} title={pageTitle} description={description} />
