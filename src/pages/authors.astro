---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";
import { sortByDate } from "../components/sortByDate";
import { COLLECTION_META } from "../consts";
const { title: pageTitle, description } = COLLECTION_META.authors;
const allAuthors = await getCollection("authors");
---

<BaseLayout title={pageTitle} description={description} is404Page={false}>
  {
    allAuthors
      .sort(sortByDate)
      .map((post) => (
        <BlogPost
          url={`/authors/${post.id}/`}
          image={post.data?.image?.src || ""}
          alt={post.data?.image?.alt || ""}
          title={post.data?.title || ""}
          description={post.data?.description || ""}
          pubDate={post.data?.pubDate || ""}
          positionx={post.data?.image?.positionx || ""}
          positiony={post.data?.image?.positiony || ""}
        />
      ))
  }
</BaseLayout>
