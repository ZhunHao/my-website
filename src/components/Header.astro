---
import Hamburger from "./Hamburger.tsx";
import Navigation from "./Navigation.astro";
import ThemeToggle from "./ThemeToggle.astro";

export interface Props {
  is404Page?: boolean;
}

const { is404Page = false } = Astro.props;
---

<header class="mb-[20px] mt-[-10px]">
  <nav
    aria-label="Main navigation"
    class="flex items-center justify-between w-full h-[30px]"
  >
    {
      !is404Page && (
        <div class="flex items-center h-[30px]">
          <a href="/" class="block" aria-label="Home">
            {/* Radiant meteor mark (same geometry as public/favicon.svg), drawn
                in currentColor so it follows the site theme with no tile */}
            <svg
              class="w-[30px] h-[30px]"
              viewBox="0 0 96 96"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="48" cy="20" r="3" fill="currentColor" stroke="none" />
              <line x1="50" y1="24" x2="20" y2="62" stroke-width="2" />
              <line x1="48" y1="26" x2="40" y2="78" stroke-width="2.5" />
              <line x1="50" y1="26" x2="62" y2="80" stroke-width="2" />
              <line x1="52" y1="24" x2="80" y2="68" stroke-width="2.2" />
              <line x1="46" y1="24" x2="14" y2="44" stroke-width="1.8" />
              <line x1="52" y1="22" x2="84" y2="42" stroke-width="1.8" />
            </svg>
          </a>
        </div>
      )
    }
    <div class="flex items-center h-[30px] gap-2">
      {
        !is404Page && (
          <>
            <div class="flex items-center justify-center h-[30px] w-[30px]">
              <ThemeToggle />
            </div>
            <div class="flex items-center justify-center h-[30px] w-[30px]">
              <Hamburger client:idle />
            </div>
          </>
        )
      }
    </div>
  </nav>
  {
    !is404Page && (
      <div class="absolute right-0 mt-2">
        <Navigation />
      </div>
    )
  }
  <slot />
</header>
